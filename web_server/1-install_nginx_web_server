cd /home/alu-system_engineering-devops/web_server
cat > 1-install_nginx_web_server <<'EOF'
#!/usr/bin/env bash
# Installs and configures Nginx to serve the required page on port 80

set -e
export DEBIAN_FRONTEND=noninteractive

apt-get update -y
apt-get install -y nginx

mkdir -p /var/www/html
cat > /var/www/html/index.html <<'HTML'
Holberton School for the win!
HTML

cat > /etc/nginx/sites-available/default <<'CONF'
server {
    listen 80 default_server;
    listen [::]:80 default_server;

    root /var/www/html;
    index index.html;

    server_name _;
    
    location / {
        try_files $uri $uri/ =404;
    }
}
CONF

nginx -t
service nginx restart || service nginx start
EOF

chmod +x 1-install_nginx_web_server
./1-install_nginx_web_server
curl 127.0.0.1
