#!/usr/bin/env bash
# Installs and configures Nginx to serve the required page on port 80

set -e
export DEBIAN_FRONTEND=noninteractive

# Update package lists and install Nginx
echo "Updating package lists..."
apt-get update -y

echo "Installing Nginx..."
apt-get install -y nginx

# Create the web page
echo "Creating the web page..."
mkdir -p /var/www/html
printf 'Holberton School\n' > /var/www/html/index.html

# Write the Nginx server block
echo "Writing the Nginx server block..."
cat > /etc/nginx/sites-available/default <<'CONF'
server {
    listen 80 default_server;
    listen [::]:80 default_server;

    root /var/www/html;
    index index.html;

    server_name _;

    location / {
        try_files $uri $uri/ =404;
    }
}
CONF

# Enable the default site
echo "Enabling the default site..."
ln -sf /etc/nginx/sites-available/default /etc/nginx/sites-enabled/default

# Validate and start Nginx
echo "Testing the Nginx configuration..."
nginx -t

echo "Starting Nginx..."
service nginx restart || service nginx start

# Show the listening port and response
echo "Nginx listening on:"
ss -ltn | grep ':80 '

echo "Response from localhost:"
curl -s http://localhost
