#!/usr/bin/env bash
# Simple script to install Nginx and serve Holberton School on port 80

set -e

# Update and install Nginx
echo "Updating package lists and installing Nginx..."
sudo apt-get update -y
sudo apt-get install -y nginx
echo "Nginx installed"
sudo service nginx reload
echo "Testing Nginx configuration..."
sudo nginx -t

# Create the web page
echo "Creating the web page..."
sudo mkdir -p /var/www/html
printf 'Holberton School\n' | sudo tee /var/www/html/index.html > /dev/null
echo "Index page created"
sudo service nginx reload
echo "Testing Nginx configuration..."
sudo nginx -t

# Write the Nginx server block
echo "Writing the Nginx server block..."
sudo printf '%s\n' 'server {' \
    '    listen 80 default_server;' \
    '    listen [::]:80 default_server;' \
    '    root /var/www/html;' \
    '    index index.html index.htm;' \
    '    server_name _;' \
    '    location / {' \
    '        try_files $uri $uri/ =404;' \
    '    }' \
    '}' > /etc/nginx/sites-available/default
echo "Server block written"
sudo service nginx reload
echo "Testing Nginx configuration..."
sudo nginx -t

# Enable the default site
echo "Enabling the default site..."
sudo ln -sf /etc/nginx/sites-available/default /etc/nginx/sites-enabled/default
echo "Default site enabled"
sudo service nginx reload
echo "Testing Nginx configuration..."
sudo nginx -t

# Show the listening port
echo "Nginx is listening on:"
sudo ss -ltn | grep ':80 '
echo "Current response from localhost:"
curl -s http://localhost
